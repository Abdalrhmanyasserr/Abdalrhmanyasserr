{
 "cells": [
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2801c7d8",
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import torch.nn as nn"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "478cf2c8",
   "metadata": {},
   "outputs": [],
   "source": [
    "input_size = 5   \n",
    "hidden_size = 10  \n",
    "seq_length = 3    \n",
    "batch_size = 1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5f675f4b",
   "metadata": {},
   "outputs": [],
   "source": [
    "x = torch.randn(seq_length, batch_size, input_size)  
    "target = torch.randn(seq_length, batch_size, hidden_size)
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b4d6c62f",
   "metadata": {},
   "outputs": [],
   "source": [
    "rnn = nn.RNN(input_size=input_size, hidden_size=hidden_size)\n",
    "\n",
    "h0 = torch.zeros(1, batch_size, hidden_size)\n",
    "\n",
    "output, hn = rnn(x, h0)\n",
    "\n",
    "criterion = nn.MSELoss()\n",
    "loss = criterion(output, target)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7221760e",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Loss before backward:\", loss.item())\n",
    "\n",
    "loss.backward()\n",
    "\n",
    "print(\"Gradient for RNN weight_ih_l0:\\n\", rnn.weight_ih_l0.grad)"
   ]
  }
 ],
